<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NfcHomeManager</RootNamespace>
    <UserSecretsId>b4b8f5a0-6d1e-4a7a-9d7a-3b1f2c9e2a11</UserSecretsId>
    <!-- Sdílí IIS app pool na Forpsi s hlavním webem Scitani1921 -
         in-process hosting povoluje jen jednu ASP.NET Core appku na pool. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

</Project>
