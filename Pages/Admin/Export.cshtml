@page
@model NfcHomeManager.Pages.Admin.ExportModel
@{
    ViewData["Title"] = "Export dat";
}

<h1>Export dat</h1>

<div class="card">
    <p class="muted">
        Stáhne celý obsah databáze (místnosti, kategorie, položky včetně kódů
        NFC štítků, servisní záznamy, plánované termíny, pojištění, léky a
        katalog léků SÚKL) jako jeden JSON soubor. Soubor obsahuje soukromá
        data domácnosti — ukládej ho mimo server a nesdílej ho.
    </p>
    <a class="btn" href="/Admin/Export?handler=Stahnout">Stáhnout JSON export</a>
    <a class="btn btn--secondary" href="/Admin/Obnova">Obnovit ze zálohy…</a>
</div>
