@page
@model NfcHomeManager.Pages.Admin.ExportModel
@{
    ViewData["Title"] = "Export dat";
}

<h1>Export dat</h1>

<div class="card">
    <p class="muted">
        Stáhne obsah databáze (místnosti, kategorie, položky, servisní
        záznamy, plánované termíny, pojištění, léky) jako jeden JSON soubor.
        Neobsahuje katalog léků SÚKL a zatím z něj nejde data obnovit; před
        každou migrací databáze vzniká vedle ní automaticky soubor .bak.
    </p>
    <a class="btn" href="/Admin/Export?handler=Stahnout">Stáhnout JSON export</a>
</div>
