@model NfcHomeManager.Pages.Polozky.PolozkaFormInput
@using NfcHomeManager.Models
@{
    var vsechnyKategorie = (List<Kategorie>)ViewData["VsechnyKategorie"]!;
    var vsechnyMistnosti = (List<Mistnost>)ViewData["VsechnyMistnosti"]!;
    var vsechnyKontejnery = (List<Polozka>)ViewData["VsechnyKontejnery"]!;

    static string RezimLabel(NfcRezim r) => r switch
    {
        NfcRezim.Predmet => "Předmět",
        NfcRezim.Kontejner => "Krabice / místnost (obsahuje předměty)",
        NfcRezim.Lekarnicka => "Lékárnička (léky a prostředky)",
        NfcRezim.PrvniPomoc => "První pomoc (samostatná krabice)",
        _ => r.ToString()
    };

    static string SpecializaceLabel(Specializace s) => s switch
    {
        Specializace.Obecna => "Obecná položka",
        Specializace.Auto => "Auto / vozidlo",
        Specializace.PlynovyKotel => "Plynový kotel",
        _ => s.ToString()
    };
}

<div class="form-grid">
    <div class="field">
        <label for="Input_Nazev">Název *</label>
        <input id="Input_Nazev" type="text" asp-for="Nazev" required />
    </div>
    <div class="field">
        <label for="Input_NfcUid">UID NFC štítku</label>
        <input id="Input_NfcUid" type="text" asp-for="NfcUid" placeholder="volitelné" />
    </div>

    <div class="field">
        <label for="Input_Rezim">Co NFC karta reprezentuje</label>
        <select id="Input_Rezim" asp-for="Rezim">
            @foreach (var r in Enum.GetValues<NfcRezim>())
            {
                <option value="@r">@RezimLabel(r)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="Input_Specializace">Specializace předmětu</label>
        <select id="Input_Specializace" asp-for="Specializace">
            @foreach (var s in Enum.GetValues<Specializace>())
            {
                <option value="@s">@SpecializaceLabel(s)</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="Input_Spz">SPZ (u vozidla)</label>
        <input id="Input_Spz" type="text" asp-for="Spz" />
    </div>
    <div class="field">
        <label for="Input_KontejnerId">Umístěno v krabici</label>
        <select id="Input_KontejnerId" asp-for="KontejnerId">
            <option value="">— není v krabici —</option>
            @foreach (var k in vsechnyKontejnery)
            {
                <option value="@k.Id">@k.Nazev</option>
            }
        </select>
        <span asp-validation-for="KontejnerId" class="muted" style="color:var(--danger);"></span>
    </div>

    <div class="field">
        <label for="Input_KategorieId">Kategorie</label>
        <select id="Input_KategorieId" asp-for="KategorieId">
            <option value="">— nezařazeno —</option>
            @foreach (var k in vsechnyKategorie)
            {
                <option value="@k.Id">@k.Nazev</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="Input_MistnostId">Místnost</label>
        <select id="Input_MistnostId" asp-for="MistnostId">
            <option value="">— nezařazeno —</option>
            @foreach (var m in vsechnyMistnosti)
            {
                <option value="@m.Id">@m.Nazev</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="Input_Vyrobce">Výrobce</label>
        <input id="Input_Vyrobce" type="text" asp-for="Vyrobce" />
    </div>
    <div class="field">
        <label for="Input_Model">Typ / model</label>
        <input id="Input_Model" type="text" asp-for="Model" />
    </div>

    <div class="field">
        <label for="Input_SerioveCislo">Sériové číslo</label>
        <input id="Input_SerioveCislo" type="text" asp-for="SerioveCislo" />
    </div>
    <div class="field">
        <label for="Input_DatumPorizeni">Datum pořízení</label>
        <input id="Input_DatumPorizeni" type="date" asp-for="DatumPorizeni" />
    </div>

    <div class="field">
        <label for="Input_CenaKc">Cena (Kč)</label>
        <input id="Input_CenaKc" type="number" step="0.01" min="0" asp-for="CenaKc" />
    </div>
    <div class="field">
        <label for="Input_ZarukaMesice">Záruka (měsíců)</label>
        <input id="Input_ZarukaMesice" type="number" min="0" max="240" asp-for="ZarukaMesice" />
    </div>

    <div class="field">
        <label for="Input_DalsiServisDo">Příští plánovaný servis / STK</label>
        <input id="Input_DalsiServisDo" type="date" asp-for="DalsiServisDo" />
    </div>
    <div class="field">
        <label for="Input_Expirace">Obecná expirace (baterie, chemie…)</label>
        <input id="Input_Expirace" type="date" asp-for="Expirace" />
    </div>
</div>

<div class="field">
    <label>Co se u této položky sleduje</label>
    <div class="checkbox-row">
        <label><input type="checkbox" asp-for="MaVlastniNfcKartu" /> má vlastní NFC kartu</label>
        <label><input type="checkbox" asp-for="SledovatPojisteni" /> pojištění</label>
        <label><input type="checkbox" asp-for="SledovatExpiraci" /> expirace</label>
        <label><input type="checkbox" asp-for="SledovatServis" /> servisní interval</label>
        <label><input type="checkbox" asp-for="SledovatRevizi" /> revize / STK</label>
    </div>
</div>

<div class="field">
    <label for="Input_Poznamka">Poznámka</label>
    <textarea id="Input_Poznamka" asp-for="Poznamka"></textarea>
</div>
