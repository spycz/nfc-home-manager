@page
@model NfcHomeManager.Pages.Polozky.UpravitModel
@{
    ViewData["Title"] = "Upravit položku";
}

<h1>Upravit položku</h1>

<div class="card">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="alert alert--error"></div>
        <partial name="_PolozkaFormFields" for="Input" view-data="ViewData" />

        <div class="actions">
            <button class="btn" type="submit">Uložit</button>
            <a class="btn btn--secondary" href="/Polozky/Detail?id=@Model.Id">Zrušit</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="/js/vendor/zxing-browser.min.js" defer></script>
    <script src="/js/barcode.js" defer></script>
}
